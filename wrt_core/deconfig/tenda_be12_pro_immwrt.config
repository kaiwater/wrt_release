# Tenda BE12 Pro (MT7987A + MT7992 / mt_wifi7)
# 上游 mt7987-mt7992-be7200 defconfig 提供 MTK Wi-Fi 7 驱动栈；
# 这里只放设备 delta，公共 app 由 compile_base.config 和 fragments 提供。
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tenda_be12-pro=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_tenda_be12-pro=""
