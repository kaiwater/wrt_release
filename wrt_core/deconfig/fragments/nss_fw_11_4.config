# Restore the 11.4 NSS firmware/driver combination.
# 11.4 is the only version that supports NSS mesh (802.11s) offload; it is also
# the version to use if you need NSS WDS or RMNET on IPQ807x.
#
# Only effective on feeds that expose the NSS_FIRMWARE_VERSION_* choice
# (for example LibWrt with the qosmio nss-packages feed). On VIKINGYFY the
# firmware version is fixed, so this fragment is a no-op there.
#
# List this fragment AFTER nss.config.
# CONFIG_NSS_FIRMWARE_VERSION_12_5 is not set
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
