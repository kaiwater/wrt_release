# macOS / Bonjour 的 SMB 服务发现（_smb._tcp）。
#
# Windows 的 WSD/LLMNR 由 wsdd2 片段负责；macOS Finder 的“网络”走 mDNS。
# ksmbd 的 procd_add_mdns 在部分 umdns 版本上不会真正广播 _smb._tcp，
# 因此用 avahi 的 smb.service 补一条。umdns 负责 .local 主机名解析。
# 目前只挂在 jdcloud_ipq60xx（京东云雅典娜 02 / CS-02 / AX6600）。
CONFIG_PACKAGE_ksmbd-avahi-service=y
CONFIG_PACKAGE_avahi-dbus-daemon=y
CONFIG_PACKAGE_umdns=y
