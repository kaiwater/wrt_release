#!/bin/sh

IEEE_PATH="/sys/class/ieee80211"
THERMAL_PATH="/sys/class/thermal"

if grep -Eq "ipq40xx|ipq806x" "/etc/openwrt_release"; then
	wifi_temp="$(awk '{printf("%.1f°C ", $0 / 1000)}' "$IEEE_PATH"/phy*/device/hwmon/hwmon*/temp1_input 2>"/dev/null" | awk '$1=$1')"
else
	wifi_temp="$(cat "$IEEE_PATH"/phy*/hwmon*/temp1_input 2>"/dev/null" | awk '{printf("%.1f°C ", $0 / 1000)}' | awk '$1=$1')"
	# mtwifi 厂商驱动（mt_wifi7）在 /proc/net/mt_wifi/tempN 暴露每个 band 的温度
	if [ -z "$wifi_temp" ]; then
		wifi_temp="$(cat /proc/net/mt_wifi/temp* 2>"/dev/null" | awk '{printf("%.1f°C ", $0 / 1000)}' | awk '$1=$1')"
	fi
fi

if grep -q "ipq40xx" "/etc/openwrt_release"; then
	if [ -e "$IEEE_PATH/phy0/hwmon0/temp1_input" ]; then
		mt76_temp="$(awk -F ': ' '{print $2}' "$IEEE_PATH/phy0/hwmon0/temp1_input" 2>"/dev/null")°C"
	fi
	[ -z "$mt76_temp" ] || wifi_temp="${wifi_temp:+$wifi_temp }$mt76_temp"
else
	cpu_temp="$(awk '{printf("%.1f°C", $0 / 1000)}' "$THERMAL_PATH/thermal_zone0/temp" 2>"/dev/null")"
fi

# PMIC 结温：IPQ807x + PMP8074 等平台在 SPMI ADC 上暴露 pmic_die（m°C）
pmic_temp=""
for d in /sys/bus/iio/devices/iio:device*; do
	case "$(cat "$d/name" 2>"/dev/null")" in
		*adc@3100*)
			v="$(cat "$d/in_temp_pmic_die_input" 2>"/dev/null")"
			[ -n "$v" ] && pmic_temp="$(awk -v x="$v" 'BEGIN{printf "%.1f°C", x / 1000}')"
			;;
	esac
done

# PoE 供电功率：只有本身带 PSE 的设备才有 pse ubus 对象，
# 普通受电设备（如 AP8220）不会输出这一项。
poe_power=""
if command -v ubus >"/dev/null" 2>&1; then
	pse="$(ubus call pse status 2>"/dev/null")"
	if [ -n "$pse" ]; then
		cost="$(printf '%s' "$pse" | grep -o '"cost":"[0-9]*' | grep -o '[0-9]*' | awk '{s += $1} END {print s + 0}')"
		[ "${cost:-0}" -gt 0 ] && poe_power="$(awk -v x="$cost" 'BEGIN{printf "%.1fW", x / 10}')"
	fi
fi

out=""
[ -n "$cpu_temp" ] && out="CPU: $cpu_temp"
[ -n "$wifi_temp" ] && out="${out:+$out, }WiFi: $wifi_temp"
[ -n "$pmic_temp" ] && out="${out:+$out, }PMIC: $pmic_temp"
[ -n "$poe_power" ] && out="${out:+$out, }PoE: $poe_power"
[ -n "$out" ] || out="No temperature info"

echo -n "$out"
