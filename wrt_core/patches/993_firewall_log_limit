#!/bin/sh
# Rate-limit fw4 log output so one dropped-packet rule cannot flood the kernel log.
#
# fw4 supports log limits at rule and zone level:
#
#   config zone
#       option name 'iotlan'
#       option log_limit '10/minute'
#
# A zone-level limit is applied to every logging rule that belongs to that zone,
# so a single setting covers existing and future rules without editing each one.
# Rules that already define their own log_limit keep their own value.
#
# Devices still using fw3/iptables do not ship /sbin/fw4 and are left untouched.

[ -x /sbin/fw4 ] || exit 0

changed=0

for zone in $(uci -q show firewall | sed -n 's/^firewall\.\([^.=]*\)=zone$/\1/p'); do
	[ -n "$(uci -q get "firewall.$zone.log_limit")" ] && continue
	uci -q set "firewall.$zone.log_limit=10/minute" || exit 0
	changed=1
done

[ "$changed" = "1" ] && uci -q commit firewall

exit 0
