From: kaiwater <kaiwater@Gmail.com>
Subject: [PATCH] mt_wifi7: expose per-band chip temperature through hwmon

The vendor mt_wifi driver reads the chip temperature for its thermal
protection logic (RTMP_GET_TEMPERATURE -> HWCMD_ID_GET_TEMPERATURE) but
never exposes the value to userspace.  The only readers are the legacy
wireless-ext ioctl OID_GET_CPU_TEMPERATURE and a cfg80211 vendor command,
neither of which is reachable from OpenWrt userspace (there is no iwpriv
and mwctl has no matching command).

As a result /sbin/tempinfo -- and therefore the "Temperature" field in
LuCI's Status/Overview -- can only report the CPU temperature on boards
using this driver.  Boards using mt76 get per-phy hwmon devices and show
"CPU: xx.x°C, WiFi: xx.x°C xx.x°C".

Register one hwmon device per band (adapter) when the hwifi layer hands
the cfg80211 context over to mt_wifi, and unregister it on the matching
teardown.  The parent device is the PCI device, so the values show up as
/sys/bus/pci/devices/<addr>/hwmon/hwmonN/temp1_input and are visible
through /sys/class/ieee80211/phy0/device/hwmon/hwmonN/temp1_input.

The temperature is queried on demand and only while the radio is
started; otherwise the sysfs read returns -ENODATA instead of blocking
on a MCU command that cannot be answered.

Signed-off-by: kaiwater <kaiwater@Gmail.com>
---
--- a/mt_wifi/include/rtmp.h
+++ b/mt_wifi/include/rtmp.h
@@ -7391,6 +7391,8 @@
 	struct bf_ctrl Bfctrl;
 #endif /* TXBF_SUPPORT */
 	RvR_Debug_CTRL RVRDBGCtrl;
+	/* hwmon device exposing the chip temperature, see cfg80211drv.c */
+	void *hwmon_dev;
 
 	BOOL							 G_MODE_INFRA_TXOP_RUNNING;
 	struct wifi_dev				  *g_mode_txop_wdev;
--- a/mt_wifi/os/linux/cfg80211/cfg80211drv.c
+++ b/mt_wifi/os/linux/cfg80211/cfg80211drv.c
@@ -26,6 +26,7 @@
 
 #include "rt_config.h"
 #include "mgmt/be_internal.h"
+#include <linux/hwmon.h>
 
 #define BSSID_WCID_TO_REMOVE 1 /* Pat:TODO */
 
@@ -4596,6 +4597,109 @@
 #endif
 }
 
+#if IS_REACHABLE(CONFIG_HWMON)
+/*
+ * Expose the per-band chip temperature to userspace through hwmon.
+ *
+ * The temperature is queried on demand via the HW control command queue,
+ * the same way the vendor ioctl (OID_GET_CPU_TEMPERATURE) and the cfg80211
+ * vendor command already do it.  The radio must be started, otherwise the
+ * MCU command would either fail or wait for a timeout.
+ */
+static umode_t mt_wifi_hwmon_is_visible(const void *drvdata,
+					enum hwmon_sensor_types type,
+					u32 attr, int channel)
+{
+	return 0444;
+}
+
+static int mt_wifi_hwmon_read(struct device *dev,
+			      enum hwmon_sensor_types type,
+			      u32 attr, int channel, long *val)
+{
+	struct _RTMP_ADAPTER *mac_ad = dev_get_drvdata(dev);
+	UINT32 temperature = 0;
+
+	if (!mac_ad)
+		return -ENODEV;
+
+	if (!RTMP_TEST_FLAG(mac_ad, fRTMP_ADAPTER_START_UP))
+		return -ENODATA;
+
+	RTMP_GET_TEMPERATURE(mac_ad, hc_get_hw_band_idx(mac_ad), &temperature);
+	if (!temperature)
+		return -ENODATA;
+
+	/* hwmon reports millidegrees Celsius */
+	*val = (long)temperature * 1000;
+
+	return 0;
+}
+
+static const struct hwmon_ops mt_wifi_hwmon_ops = {
+	.is_visible = mt_wifi_hwmon_is_visible,
+	.read = mt_wifi_hwmon_read,
+};
+
+static const struct hwmon_channel_info * const mt_wifi_hwmon_info[] = {
+	HWMON_CHANNEL_INFO(temp, HWMON_T_INPUT),
+	NULL
+};
+
+static const struct hwmon_chip_info mt_wifi_hwmon_chip_info = {
+	.ops = &mt_wifi_hwmon_ops,
+	.info = mt_wifi_hwmon_info,
+};
+
+static void mt_wifi_hwmon_register(struct _RTMP_ADAPTER *mac_ad)
+{
+	struct wiphy *wiphy = NULL;
+	struct device *dev;
+	struct device *hwmon_dev;
+
+	if (mac_ad->hwmon_dev)
+		return;
+
+	if (mac_ad->pCfg80211_CB && mac_ad->pCfg80211_CB->pCfg80211_Wdev)
+		wiphy = mt_cfg80211_get_wiphy(
+				mac_ad->pCfg80211_CB->pCfg80211_Wdev);
+	if (!wiphy)
+		return;
+
+	/* wiphy_dev() is the PCI function device set by the hwifi layer */
+	dev = wiphy_dev(wiphy);
+	if (!dev)
+		return;
+
+	hwmon_dev = hwmon_device_register_with_info(dev, "mt_wifi", mac_ad,
+			&mt_wifi_hwmon_chip_info, NULL);
+	if (IS_ERR(hwmon_dev)) {
+		MTWF_DBG(mac_ad, DBG_CAT_CFG, CATCFG_DBGLOG, DBG_LVL_WARN,
+			 "hwmon registration failed (%ld)\n", PTR_ERR(hwmon_dev));
+		return;
+	}
+
+	mac_ad->hwmon_dev = hwmon_dev;
+}
+
+static void mt_wifi_hwmon_unregister(struct _RTMP_ADAPTER *mac_ad)
+{
+	if (!mac_ad->hwmon_dev)
+		return;
+
+	hwmon_device_unregister((struct device *)mac_ad->hwmon_dev);
+	mac_ad->hwmon_dev = NULL;
+}
+#else
+static void mt_wifi_hwmon_register(struct _RTMP_ADAPTER *mac_ad)
+{
+}
+
+static void mt_wifi_hwmon_unregister(struct _RTMP_ADAPTER *mac_ad)
+{
+}
+#endif /* CONFIG_HWMON */
+
 int cfg80211_drv_init_cmd_handle(
 	struct _RTMP_ADAPTER *mac_ad,
 	struct wifi_dev *wdev,
@@ -4614,11 +4718,14 @@
 			mac_ad->cfg80211_ctrl.wiphy = mt_cfg80211_get_wiphy(
 					mac_ad->pCfg80211_CB->pCfg80211_Wdev);
 		CFG80211_reSetToDefault(mac_ad);
+		mt_wifi_hwmon_register(mac_ad);
 	} else if (sub_cmd == MT_80211_GET_BAND_INFO)
 		cfg80211_drv_get_band_info(
 			mac_ad, wdev, (struct mt_cfg80211_band *)ioctl_cfg->data);
-	else if (sub_cmd == MT_80211_DRIVER_UNREGISTER)
+	else if (sub_cmd == MT_80211_DRIVER_UNREGISTER) {
+		mt_wifi_hwmon_unregister(mac_ad);
 		cfg80211_drv_unregister(mac_ad);
+	}
 	return ret;
 }
 
